<Window x:Class="ClubEQ.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:ClubEQ.UI"
        Title="ClubEQ" Icon="Assets/ClubEQ.ico" Width="1280" Height="800" MinWidth="560" MinHeight="480"
        Background="{StaticResource Bg}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource BodyFont}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource SideBg}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,0,0,1" Padding="18,12">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,4,28,4" VerticalAlignment="Center">
                    <TextBlock Text="CLUB" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Black">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#C59BFF" Offset="0"/><GradientStop Color="#8B6BFF" Offset="1"/></LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect><DropShadowEffect Color="#9B6BFF" BlurRadius="18" ShadowDepth="0" Opacity="1"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="EQ" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Black" Foreground="{StaticResource NeonBrush}">
                        <TextBlock.Effect><DropShadowEffect Color="#FF3DA8" BlurRadius="16" ShadowDepth="0" Opacity="0.9"/></TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <StackPanel Margin="0,4,16,4" Width="200">
                    <TextBlock Text="PRESET" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="PresetBox"/>
                </StackPanel>
                <StackPanel Margin="0,4,16,4" Width="220">
                    <TextBlock Text="INPUT" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="InputBox"/>
                </StackPanel>
                <StackPanel Margin="0,4,16,4" Width="220">
                    <TextBlock Text="OUTPUT" Style="{StaticResource Label}"/>
                    <ComboBox x:Name="OutputBox"/>
                </StackPanel>
                <StackPanel Margin="0,4,16,4" Width="190">
                    <TextBlock x:Name="MasterLabel" Text="MASTER" Style="{StaticResource Label}"/>
                    <Slider x:Name="MasterSlider" Minimum="-40" Maximum="24" Value="0" SmallChange="0.5" LargeChange="3"
                            ToolTip="0 dB = as loud as CATCAR (measured). Double-click the label for 0 dB."/>
                    <CheckBox x:Name="LimiterBox" Style="{StaticResource Switch}" Content="Limiter" Margin="0,4,0,0" HorizontalAlignment="Left"
                              ToolTip="On: peaks over -1 dBFS are turned down instead of clipping. Off: nothing touches the sound, peaks over 0 dBFS clip."/>
                </StackPanel>
                <StackPanel Margin="0,4,16,4" Width="150" VerticalAlignment="Bottom">
                    <DockPanel>
                        <Border x:Name="ClipChip" DockPanel.Dock="Right" CornerRadius="999" Padding="7,1" Background="#2A265C" Cursor="Hand"
                                ToolTip="Lights when the output went over full scale (CLIP) or the limiter had to work (LIMIT). Click to reset.">
                            <TextBlock x:Name="ClipText" Text="CLEAN" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                        </Border>
                        <TextBlock x:Name="PeakText" Text="IN / OUT" Style="{StaticResource Label}"/>
                    </DockPanel>
                    <Border Height="5" CornerRadius="2" Background="#2A265C" Margin="0,3,0,3" ToolTip="Input">
                        <Border x:Name="InMeter" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource CyanBrush}"/>
                    </Border>
                    <Grid x:Name="OutMeters" ToolTip="Output left / right before the limiter, -48 to +6 dBFS; the line is 0 dBFS">
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <Border Height="5" CornerRadius="2" Background="#2A265C" Margin="0,0,0,2">
                            <Grid><Border x:Name="OutL" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource NeonBrush}"/>
                                  <Border x:Name="HoldL" HorizontalAlignment="Left" Width="2" Background="{StaticResource TextBrush}"/></Grid>
                        </Border>
                        <Border Grid.Row="1" Height="5" CornerRadius="2" Background="#2A265C">
                            <Grid><Border x:Name="OutR" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource NeonBrush}"/>
                                  <Border x:Name="HoldR" HorizontalAlignment="Left" Width="2" Background="{StaticResource TextBrush}"/></Grid>
                        </Border>
                        <Border Grid.RowSpan="2" Width="1" HorizontalAlignment="Left" Margin="133,-1,0,-1" Background="{StaticResource WarnBrush}" IsHitTestVisible="False"/>
                    </Grid>
                </StackPanel>
                <ToggleButton x:Name="EqButton" Style="{StaticResource Pill}" Content="EQ" Margin="0,4,12,4" VerticalAlignment="Bottom" ToolTip="Show the master EQ"/>
                <Button x:Name="SettingsButton" Style="{StaticResource BtnSmall}" Content="⚙ Settings" Margin="0,4,6,4" VerticalAlignment="Bottom" ToolTip="Audio path and latency"/>
                <Button x:Name="HelpButton" Style="{StaticResource BtnSmall}" Content="? Help" Margin="0,4,12,4" VerticalAlignment="Bottom" ToolTip="How to set up the Voicemeeter insert (lowest delay, no doubled sound)"/>
                <Button x:Name="PowerButton" Style="{StaticResource BtnPrimary}" Content="Start" MinWidth="96" Margin="0,4,0,4" VerticalAlignment="Bottom"/>
            </WrapPanel>
        </Border>

        <!-- Macro strip -->
        <StackPanel Grid.Row="1">
            <!-- Master EQ, opened with the EQ pill -->
            <Border x:Name="EqPanel" Visibility="Collapsed" Style="{StaticResource Card}" Margin="18,12,18,0" Padding="14,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Width="120" Margin="0,0,16,0">
                        <TextBlock Text="MASTER EQ" Style="{StaticResource Label}"/>
                        <CheckBox x:Name="EqOn" Style="{StaticResource Switch}" Content="On" Margin="0,8,0,8" HorizontalAlignment="Left"/>
                        <Button x:Name="EqFlat" Style="{StaticResource BtnSmall}" Content="Flat" HorizontalAlignment="Left"/>
                        <TextBlock Text="±12 dB. Double-click a band for 0." Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                    </StackPanel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="EqBands" Orientation="Horizontal"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="18,12,18,0">
                <StackPanel x:Name="MacroStrip" Orientation="Horizontal"/>
            </ScrollViewer>
        </StackPanel>

        <!-- Room + inspector; the inspector moves under the room in a narrow window -->
        <Grid x:Name="Main" Grid.Row="2" Margin="18,12,18,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RoomCol" Width="*"/>
                <ColumnDefinition x:Name="InspCol" Width="400"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RoomRow" Height="*"/>
                <RowDefinition x:Name="InspRow" Height="0"/>
            </Grid.RowDefinitions>
            <Border x:Name="RoomBorder" Style="{StaticResource Stage}" Padding="0" ClipToBounds="True">
                <Grid>
                    <ui:RoomCanvas x:Name="Room"/>
                    <TextBlock Text="drag to move · wheel to turn · right-click a speaker: its own Underground on/off · click empty floor for the room" Style="{StaticResource Small}"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10" IsHitTestVisible="False" Opacity="0.7"/>
                </Grid>
            </Border>
            <Border x:Name="InspBorder" Grid.Column="1" Style="{StaticResource Card}" Margin="12,0,0,0" Padding="18,14,10,14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <StackPanel x:Name="InspectorPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status line -->
        <Border Grid.Row="3" Background="{StaticResource SideBg}" BorderBrush="{StaticResource BorderBrush1}" BorderThickness="0,1,0,0" Padding="18,6">
            <TextBlock x:Name="StatusText" Style="{StaticResource Small}" Text="Stopped" TextTrimming="CharacterEllipsis"/>
        </Border>
    </Grid>
</Window>
